generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/product-client"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres:postgres@localhost:5432/product?schema=public"
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  price       Float
  quantity    Int?
  description String?
  tags        String?
  createAt    DateTime @default(now())
}

model OutboxEvent {
  id          Int         @id @default(autoincrement())
  eventType   String
  payload     Json
  status      String      @default("PENDING")
  createAt    DateTime    @default(now())
  processedAt DateTime?

  @@index([status, createAt])
}
